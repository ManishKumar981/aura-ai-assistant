# Copy to .env and fill in your own values. Never commit real keys.

# ---------------------------------------------------------------------------
# Backend (Supabase) — client-side, publishable values only
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side copies used to verify bearer tokens on API routes
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# AI Doctor / LLM provider (server-side only)
# AI_PROVIDER: lovable | openai-compatible | demo
#   openai-compatible  -> Gemini via the OpenAI-compatible endpoint
#   lovable            -> optional provider retained for compatibility only
#   demo               -> no model calls, deterministic scripted replies
# Keep the API key server-side only. Never expose it in frontend/client code.
# ---------------------------------------------------------------------------
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash
AI_API_KEY=

# ---------------------------------------------------------------------------
# Speech-to-text provider (server-side only)
# STT_PROVIDER: lovable | openai-compatible | none
#   none -> transcription endpoint returns 503 (voice input disabled)
# Text-to-speech uses the browser SpeechSynthesis API and needs no configuration.
# ---------------------------------------------------------------------------
STT_PROVIDER=lovable
STT_BASE_URL=
STT_MODEL=
STT_API_KEY=
STT_STREAM=true

# ---------------------------------------------------------------------------
# Lovable-hosted runtime only (used when AI_PROVIDER/STT_PROVIDER=lovable)
# ---------------------------------------------------------------------------
LOVABLE_API_KEY=
